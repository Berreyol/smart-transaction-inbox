# Copy this file to .env and fill in your Supabase project's values
# (Project Settings > API in the Supabase dashboard).
#
# EXPO_PUBLIC_* vars are inlined into the JS bundle at build time by Expo,
# so only ever put the public publishable key here — never the service_role key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# The address Pipedream's Email trigger minted for your workflow (see
# README.md "Pipedream workflow" setup). Used only to display each user's
# personalized forwarding address (base+<their token>@domain) in-app —
# never sent anywhere, safe to be public.
EXPO_PUBLIC_INBOUND_EMAIL_ADDRESS=your-pipedream-address@pipedream.net

# ----------------------------------------------------------------------------
# Used only by scripts/ (never by the app — deliberately NOT prefixed with
# EXPO_PUBLIC_, so these never get inlined into the client bundle). See
# scripts/seed-pending-transaction.mjs's header comment.
# ----------------------------------------------------------------------------
TEST_WEBHOOK_TOKEN=your-dev-project-webhook-token
TEST_USER_FORWARDING_TOKEN=your-dev-profile-forwarding-token
